# Путь к корню проекта, который будем обрабатывать
ROOT_DIR=your_project_path

# Включение модульного режима: отдельный экстракт для каждой папки
MODULAR_MODE=false

# Список папок, которые нужно исключить из обработки
EXCLUDE_DIRS=.venv,__pycache__,node_modules,.idea,.git,out

# Список файлов, содержимое которых нужно скрыть (маски через запятую)
HIDE_FILE_CONTENTS=*.tmp,*.txt,*.bak,*.log,*.min.js,*.min.css,package-lock.json,yarn.lock

# Чувствительные файлы, которые будут скрыты при SAFE_MODE=true
SENSITIVE_FILES=.env,*.secret,config/prod.json

# Включение безопасного режима: чувствительные файлы будут REDACTED
SAFE_MODE=true

# Максимальный размер файла для включения в экстракт (в байтах)
MAX_FILE_SIZE=5242880  # 5MB

# Кодировка файлов
ENCODING=utf-8